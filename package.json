{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-models-discovery",
  "version": "2.2.0-cliproxy.1",
  "description": "OpenCode plugin for auto-discovery of OpenAI-compatible models with dynamic provider configuration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./types/server.d.ts",
      "default": "./dist/server.js"
    },
    "./tui": {
      "types": "./types/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/THIRD-PARTY-NOTICES.md",
    "types"
  ],
  "keywords": [
    "opencode",
    "openai-compatible",
    "model-discovery",
    "plugin",
    "local-llm",
    "ollama",
    "lmstudio",
    "lm-studio",
    "localai"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "opencode": ">=1.18.29"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d4em0n/opencode-models-discovery.git"
  }
}
